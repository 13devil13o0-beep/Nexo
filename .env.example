# ═══════════════════════════════════════════════════════════════
# 🤖 MyAssistBOT - Configuração
# Copia este ficheiro para .env e preenche os valores
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# AI PROVIDERS (Multi-provider com fallback automático)
# ─────────────────────────────────────────────────────────────────
# Groq - Provider principal (https://console.groq.com/keys - GRÁTIS)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MODEL=llama-3.1-70b-instruct
# FALLBACK_MODEL=llama-3.1-70b-instruct

MODEL=llama3:latest

# Cerebras - Fallback rápido (https://cloud.cerebras.ai/ - GRÁTIS)
CEREBRAS_API_KEY=

# Google Gemini - Fallback (https://aistudio.google.com/apikey - GRÁTIS)
GEMINI_API_KEY=

# HuggingFace - Fallback (https://huggingface.co/settings/tokens - GRÁTIS)
HF_API_KEY=

# Ollama - Fallback local (https://ollama.ai - GRÁTIS, corre offline)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Ordem de preferência dos providers (separados por vírgula)
# Disponíveis: groq, cerebras, gemini, huggingface, ollama
LLM_PROVIDER_ORDER=groq,cerebras,gemini,huggingface,ollama

# ─────────────────────────────────────────────────────────────────
# WEB SEARCH
# ─────────────────────────────────────────────────────────────────
# Serper.dev - 2500 pesquisas/mês grátis (https://serper.dev)
SERPER_API_KEY=

# ─────────────────────────────────────────────────────────────────
# BOTS (OPCIONAL)
# ─────────────────────────────────────────────────────────────────
# Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Discord (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# WhatsApp via Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:

# ─────────────────────────────────────────────────────────────────
# PORTAS
# ─────────────────────────────────────────────────────────────────
PORT=7777
WEBHOOK_PORT=3002

# ─────────────────────────────────────────────────────────────────
# AMBIENTE
# ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────
# SEGURANÇA
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=MUDA_ESTE_SECRET_AQUI
CONFIRM_SENSITIVE_ACTIONS=true
MAX_EXEC_PER_MIN=5

# ─────────────────────────────────────────────────────────────────
# SYSTEM CONTROLLER (Level 1)
# ─────────────────────────────────────────────────────────────────
SYSTEM_CONTROLLER_ENABLED=true
ALLOWED_PATHS=
ALLOWED_COMMANDS=dir,ls,cat,type,echo,node,npm,npx,python,pip,git,code,start,explorer
REQUIRE_CONFIRMATION=true
ALLOWED_EXTENSIONS=.txt,.json,.js,.ts,.md,.html,.css,.py,.env,.yaml,.yml

# ─────────────────────────────────────────────────────────────────
# INPUT AGENT - Level 3 (Teclado, Rato, Screenshots)
# ─────────────────────────────────────────────────────────────────
INPUT_AGENT_ENABLED=true
INPUT_REQUIRE_APPROVAL=true
INPUT_RATE_LIMIT=30

# ─────────────────────────────────────────────────────────────────
# WEBHOOKS
# ─────────────────────────────────────────────────────────────────
STRIPE_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
WEBHOOK_SECRET=
WEBHOOK_URL=


# ═══════════════════════════════════════════════════════════
# NÍVEL PAGO E SENTINELA DE MODELOS
# ═══════════════════════════════════════════════════════════

# Como é usado o provider pago do utilizador (OpenAI, Claude, etc.):
#   escalate (padrão) — último recurso, ou quando a tarefa pede qualidade.
#                       Pedidos triviais continuam a custar 0€.
#   always            — intercepta todos os pedidos (comportamento antigo).
CUSTOM_PROVIDER_MODE=escalate

# Modelo de reserva do Ollama. Tem de estar instalado ("ollama pull <modelo>").
# Confirma o que tens instalado com: npm run check:models
OLLAMA_FALLBACK_MODEL=mistral

# Sentinela de modelos: avisa no arranque quando um fornecedor descontinua
# o modelo configurado. Põe a 0 para desligar.
MODEL_HEALTHCHECK=1
MODEL_HEALTHCHECK_TIMEOUT=8000

# Contabilidade de tokens, custo e latência (memory/metrics.jsonl).
# Relatório: npm run metrics — põe a 0 para desligar o registo.
METRICS=1

# Tempo que o modelo Ollama fica residente em memória após responder.
# Evita o carregamento a frio (~57 s medidos). '-1' = sempre, '0' = nunca.
OLLAMA_KEEP_ALIVE=30m

# Carregar o modelo local no arranque do servidor. 0 para desligar.
OLLAMA_WARMUP=1

# Encaminhamento por tamanho do prompt.
# Pedidos até este número de tokens ficam no modelo local (grátis, privado,
# não sai da máquina). Acima disto vão para um fornecedor remoto, porque o
# local processa o prompt no CPU.
#
# Medido nesta máquina: 2,3 s fixos + 49 ms por token de entrada.
#   100 tokens ->  7 s     400 tokens -> 22 s
#   150 tokens -> 10 s     900 tokens -> 46 s
#
# Com placa gráfica, sobe este valor. Confirma com: npm run metrics
LOCAL_MAX_PROMPT_TOKENS=150

# ═══════════════════════════════════════════════════════════
# FERRAMENTAS (nível 2 da cascata)
# ═══════════════════════════════════════════════════════════

# Quando o parser de regras não reconhece o pedido, o modelo pode escolher
# entre um conjunto de ferramentas. Põe a 0 para voltar ao comportamento
# antigo, em que esses pedidos caíam em conversa genérica.
TOOLS_ENABLED=1

# Máximo de ferramentas enviadas por pedido. O pré-filtro escolhe as
# plausíveis pelas palavras da mensagem. Enviar o catálogo inteiro custaria
# ~1086 tokens em cada pedido; com o filtro fica tipicamente em 60 a 170.
TOOLS_MAX_PER_REQUEST=6

# Tecto de idas ao modelo dentro de um ciclo de ferramentas.
TOOLS_MAX_STEPS=4

# Tempo máximo de execução de código no sandbox isolado (ms).
# O código corre num processo-filho sem segredos no ambiente; ao fim deste
# tempo o processo é morto à força.
CODE_EXEC_TIMEOUT_MS=5000

# Modo estrito de permissões. Com 1, também as ferramentas que ESCREVEM
# (criar nota, criar PDF) passam a exigir aprovação explícita, além das de
# sistema. Recomendado em máquinas partilhadas ou expostas à internet.
TOOLS_STRICT=0

# ═══════════════════════════════════════════════════════════
# CLAUDE COMO FORNECEDOR DE PRIMEIRA CLASSE
# ═══════════════════════════════════════════════════════════

# O Claude é agora um fornecedor do router, com chamada de ferramentas no
# formato da Anthropic. Só entra na cadeia se o acrescentares à ordem:
#   LLM_PROVIDER_ORDER=groq,anthropic,ollama
#
# A chave, de https://console.anthropic.com/ . Deixa vazio se não usares o
# Claude: uma chave inválida é pior do que nenhuma, porque tapa as outras.
ANTHROPIC_API_KEY=

# Modelo usado. O Opus 5 tem raciocínio ligado por omissão.
ANTHROPIC_MODEL=claude-opus-5

# Profundidade do raciocínio: low, medium, high, xhigh, max.
# 'low' é o suficiente para o ciclo de ferramentas e é o mais barato.
ANTHROPIC_EFFORT=low
